# Frontend (Vite) environment variables.
# Public application URLs used by the Next.js frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public, HHP-approved Stripe-hosted donation link. Only HTTPS links hosted on
# buy.stripe.com, donate.stripe.com, or checkout.stripe.com are accepted.
# Leave blank until the link has been approved; the donation page will not
# publish a placeholder or broken checkout destination.
NEXT_PUBLIC_STRIPE_DONATION_URL=

# Community Voices reads the Google responses sheet directly (gviz endpoint).
# The sheet must be shared as "Anyone with the link can view".
# From the sheet URL .../spreadsheets/d/<SHEET_ID>/edit#gid=<SHEET_GID>
# Leave VITE_SHEET_ID blank to fall back to built-in sample data.
VITE_SHEET_ID=
VITE_SHEET_GID=
