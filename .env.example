# Frontend (Vite) environment variables.
# Only VITE_-prefixed keys are exposed to the browser via import.meta.env.
VITE_API_URL=http://localhost:8000/api

# Community Voices reads the Google responses sheet directly (gviz endpoint).
# The sheet must be shared as "Anyone with the link can view".
# From the sheet URL .../spreadsheets/d/<SHEET_ID>/edit#gid=<SHEET_GID>
# Leave VITE_SHEET_ID blank to fall back to built-in sample data.
VITE_SHEET_ID=
VITE_SHEET_GID=
