{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "human-health-project/frontend-cloud",
    "type": "project",
    "description": "Laravel Cloud wrapper for the statically exported HHP Next.js frontend.",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
